# Debug deve permanecer desativado em produção.
APP_DEBUG=false

# Banco operacional dos campeonatos
DB_HOST=127.0.0.1
DB_NAME_CAMPEONATOS=nome_do_banco_campeonatos
DB_USER=usuario_do_banco
DB_PASS=senha_do_banco

# Banco do site principal, usado para consultar filiados
MAIN_DB_NAME=nome_do_banco_principal
MAIN_DB_USER=usuario_do_banco_principal

# Criados no primeiro acesso se ainda não houver administrador.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-com-12-caracteres

# Opcional: informe apenas se forem diferentes dos valores acima.
# DB_PORT=3306
# MAIN_DB_HOST=127.0.0.1
# MAIN_DB_PORT=3306
# MAIN_DB_PASS=senha_do_banco_principal
